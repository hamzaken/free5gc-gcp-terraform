# Settings for GCP projects with restrictive organisation policies, such as
# training sandboxes (A Cloud Guru / Pluralsight). Verified end to end on
# 2026-10-13 (docs/testing.md).
#
#   cp terraform/infra/terraform.tfvars.sandbox.example terraform/infra/terraform.tfvars
#
# Check what your project allows first (read-only):
#   gcloud resource-manager org-policies describe constraints/gcp.resourceLocations \
#     --project <project-id> --effective
#   gcloud compute regions describe <region> --project <project-id>   # CPUS quota

project_id = "my-sandbox-project"

# gcp.resourceLocations often excludes europe-west9 (Paris); europe-west1
# (Belgium) is the closest commonly allowed EU region.
region = "europe-west1"
zone   = "europe-west1-b"

# Machine-type allow-lists often reject e2-standard-4. Two e2-standard-2 nodes
# give the same 4 vCPU the general pool needs; one e2-standard-2 is not enough
# (Pods stay Pending). Total with the UPF node: 6 vCPU, within a typical
# 8-vCPU regional quota.
general_pool = {
  machine_type = "e2-standard-2"
  node_count   = 2
}

upf_pool = {
  machine_type = "e2-standard-2"
  node_count   = 1
}

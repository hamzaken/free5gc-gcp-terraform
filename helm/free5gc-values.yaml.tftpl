# Rendered by terraform/platform from config/*.yaml. Do not edit the output.
# Contains no secrets: MongoDB credentials are referenced by Secret name only.
#
# Chart: free5gc-helm v4.2.2 (free5gc chart 1.1.7) + helm/patches/*.
# Every key below exists in the pinned chart; see docs/architecture.md.

global:
  userPlaneArchitecture: single
  uesubnet: ${jsonencode(ue_cidr)}
  sbi:
    scheme: http
  amf:
    multus:
      enabled: false
    service:
      ngap:
        enabled: true
        name: amf-n2
        port: 38412
        nodeport: 31412
        protocol: SCTP
        # ClusterIP only (patch 0002). SCTP on Dataplane V2 requires
        # port == targetPort, which holds because targetPort defaults to port.
        type: ClusterIP
  smf:
    multus:
      enabled: false
  upf:
    multus:
      enabled: false
  # patch 0003: authenticated MongoDB URI for NRF, UDR, PCF, CHF.
  mongodbAuth:
    enabled: true
    secretName: mongodb-credentials
    passwordKey: mongodb-passwords
    username: free5gc
    database: free5gc

deployMongoDb: true
deployAmf: true
deployAusf: true
deployChf: true
deployN3iwf: false
deployNef: true
deployNrf: true
deployNssf: true
deployPcf: true
deploySmf: true
deployUdm: true
deployUdr: true
deployUpf: true
# The WebConsole ships a default admin account (admin/free5gc) and is not
# needed: subscribers are provisioned by a Kubernetes Job.
deployWebui: false
deployDbPython: false

mongodb:
  fullnameOverride: mongodb
  image:
    registry: ${jsonencode(mongodb_image.registry)}
    repository: ${jsonencode(mongodb_image.repository)}
    tag: ${jsonencode(mongodb_image.tag)}
    digest: ${jsonencode(mongodb_image.digest)}
  auth:
    enabled: true
    # Keys: mongodb-root-password, mongodb-passwords (synced from Secret Manager).
    existingSecret: mongodb-credentials
    usernames:
      - free5gc
    databases:
      - free5gc
  # Remove the upstream microk8s hostPath PersistentVolume.
  extraDeploy: []
  # The upstream values run an init container that apt-installs tini from an
  # unpinned debian:12-slim image as root on every start, to use it as PID 1.
  # Not reproducible and not needed: use the Bitnami image's own entrypoint.
  initContainers: []
  extraVolumes: []
  extraVolumeMounts: []
  command: []
  args: []
  persistence:
    enabled: true
    # GKE Persistent Disk CSI (pd-balanced), encrypted at rest by Google.
    storageClass: standard-rwo
    size: 8Gi
    # Upstream mounts the volume directly on the data directory
    # (/bitnami/mongodb/data/db/). A fresh ext4 Persistent Disk contains
    # lost+found, so Bitnami treats it as "persisted data" and skips creating
    # the root and application users while still enabling authentication.
    # Bitnami's default mount point keeps the data directory a fresh subdir.
    mountPath: /bitnami/mongodb
  # Replaced by the NetworkPolicies managed in terraform/platform.
  networkPolicy:
    enabled: false
  nodeSelector: ${jsonencode(general_node_selector)}
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 1Gi

# --- Network functions -------------------------------------------------------
# Per-NF image pins, init-container images and nodeSelectors are generated in
# terraform/platform (local.nf_common_values) and passed as a separate values
# document; Helm deep-merges it with this file.

free5gc-nrf:
  nrf:
    configuration:
      configuration: |-
        DefaultPlmnId:
          mcc: ${jsonencode(mcc)}
          mnc: ${jsonencode(mnc)}

free5gc-ausf:
  ausf:
    configuration:
      configuration: |-
        plmnSupportList:
          - mcc: ${jsonencode(mcc)}
            mnc: ${jsonencode(mnc)}
        groupId: ausfGroup001
        eapAkaSupiImsiPrefix: false

free5gc-amf:
  amf:
    configuration:
      configuration: |-
        amfName: AMF
        serviceNameList:
          - namf-comm
          - namf-evts
          - namf-mt
          - namf-loc
          - namf-oam
        servedGuamiList:
          - plmnId:
              mcc: ${jsonencode(mcc)}
              mnc: ${jsonencode(mnc)}
            amfId: cafe00
        supportTaiList:
          - plmnId:
              mcc: ${jsonencode(mcc)}
              mnc: ${jsonencode(mnc)}
            tac: ${jsonencode(tac_hex)}
        plmnSupportList:
          - plmnId:
              mcc: ${jsonencode(mcc)}
              mnc: ${jsonencode(mnc)}
            snssaiList:
              - sst: ${sst}
                sd: ${jsonencode(sd)}
        supportDnnList:
          - ${jsonencode(dnn)}
        security:
          integrityOrder:
            - NIA2
          # Upstream default is NEA0 only (no NAS ciphering). Prefer NEA2.
          cipheringOrder:
            - NEA2
            - NEA0
        networkName:
          full: free5GC
          short: free
        ngapIE:
          mobilityRestrictionList:
            enable: true
          maskedIMEISV:
            enable: true
          redirectionVoiceFallback:
            enable: false
        nasIE:
          networkFeatureSupport5GS:
            enable: true
            length: 1
            imsVoPS: 0
            emc: 0
            emf: 0
            iwkN26: 0
            mpsi: 0
            emcN3: 0
            mcsi: 0
        t3502Value: 720
        t3512Value: 3600
        non3gppDeregTimerValue: 3240
        t3513:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        t3522:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        t3550:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        t3555:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        t3560:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        t3565:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        t3570:
          enable: true
          expireTime: 6s
          maxRetryTimes: 4
        locality: area1
        sctp:
          numOstreams: 3
          maxInstreams: 5
          maxAttempts: 2
          maxInitTimeout: 2
        defaultUECtxReq: false

free5gc-nssf:
  nssf:
    configuration:
      configuration: |-
        nssfName: NSSF
        supportedPlmnList:
          - mcc: ${jsonencode(mcc)}
            mnc: ${jsonencode(mnc)}
        supportedNssaiInPlmnList:
          - plmnId:
              mcc: ${jsonencode(mcc)}
              mnc: ${jsonencode(mnc)}
            supportedSnssaiList:
              - sst: ${sst}
                sd: ${jsonencode(sd)}
        amfSetList: []
        amfList: []
        # NSSF checks slice support per TAI (util.CheckSupportedSnssaiInTa).
        taList:
          - tai:
              plmnId:
                mcc: ${jsonencode(mcc)}
                mnc: ${jsonencode(mnc)}
              tac: ${jsonencode(tac_hex)}
            accessType: 3GPP_ACCESS
            supportedSnssaiList:
              - sst: ${sst}
                sd: ${jsonencode(sd)}
        mappingListFromPlmn: []

free5gc-smf:
  smf:
    configuration:
      configuration: |-
        smfName: SMF
        snssaiInfos:
          - sNssai:
              sst: ${sst}
              sd: ${jsonencode(sd)}
            dnnInfos:
              - dnn: ${jsonencode(dnn)}
                dns:
                  ipv4: ${jsonencode(ue_dns_ipv4)}
        plmnList:
          - mcc: ${jsonencode(mcc)}
            mnc: ${jsonencode(mnc)}
        userplaneInformation:
          upNodes:
            gNB1:
              type: AN
            UPF:
              type: UPF
              # Replaced at runtime by the SMF wrapper (patch 0001) with the
              # UPF Pod IP resolved from its headless Service.
              nodeID: UPF_SERVICE_NAME
              sNssaiUpfInfos:
                - sNssai:
                    sst: ${sst}
                    sd: ${jsonencode(sd)}
                  dnnUpfInfoList:
                    - dnn: ${jsonencode(dnn)}
                      pools:
                        - cidr: ${jsonencode(ue_cidr)}
              interfaces:
                - interfaceType: N3
                  endpoints:
                    - UPF_SERVICE_NAME
                  networkInstances:
                    - ${jsonencode(dnn)}
          links:
            - A: gNB1
              B: UPF
        locality: area1
        t3591:
          enable: true
          expireTime: 16s
          maxRetryTimes: 3
        t3592:
          enable: true
          expireTime: 16s
          maxRetryTimes: 3
      ueRoutingInfo: |-
        UE1:
          members:
%{ for imsi in imsis ~}
            - ${jsonencode("imsi-${imsi}")}
%{ endfor ~}
          topology:
            - A: gNB1
              B: UPF
      logger:
        enable: true
        level: info
        reportCaller: false

free5gc-upf:
  upf:
    image:
      name: ${jsonencode(images[ "upf" ].name)}
      tag: ${jsonencode(images[ "upf" ].tag)}
    nodeSelector: ${jsonencode(upf_node_selector)}
    tolerations: ${jsonencode(upf_tolerations)}
    # patch 0004: never start the UPF without a compatible gtp5g module.
    initContainers:
      - name: wait-gtp5g
        image: ${jsonencode(image_refs[ "busybox" ])}
        env:
          - name: GTP5G_MIN
            value: ${jsonencode(gtp5g_min)}
          - name: GTP5G_MAX_EXCLUSIVE
            value: ${jsonencode(gtp5g_max_exclusive)}
        command: ["/bin/sh", "-c"]
        args:
          - |
            ver() { echo "$1" | awk -F. '{ printf "%03d%03d%03d", $1, $2, $3 }'; }
            i=0
            while [ "$i" -lt 120 ]; do
              if [ -r /sys/module/gtp5g/version ]; then
                v="$(cat /sys/module/gtp5g/version)"
                if [ "$(ver "$v")" -ge "$(ver "$GTP5G_MIN")" ] && [ "$(ver "$v")" -lt "$(ver "$GTP5G_MAX_EXCLUSIVE")" ]; then
                  echo "gtp5g $v loaded (accepted range [$GTP5G_MIN, $GTP5G_MAX_EXCLUSIVE))"
                  exit 0
                fi
                echo "gtp5g $v is loaded but outside [$GTP5G_MIN, $GTP5G_MAX_EXCLUSIVE); refusing to start the UPF"
                exit 1
              fi
              echo "waiting for the gtp5g kernel module (see DaemonSet gtp5g-system/gtp5g-loader)..."
              i=$((i + 1))
              sleep 5
            done
            echo "gtp5g not loaded after 10 minutes"
            exit 1
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65534
    configuration:
      dnnList:
        - dnn: ${jsonencode(dnn)}
          cidr: ${jsonencode(ue_cidr)}
      logger:
        enable: true
        level: info
        reportCaller: false

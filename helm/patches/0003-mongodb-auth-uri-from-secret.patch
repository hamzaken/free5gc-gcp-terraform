diff --git a/charts/free5gc/charts/free5gc-chf/templates/chf-deployment.yaml b/charts/free5gc/charts/free5gc-chf/templates/chf-deployment.yaml
index 7d9f90d..8cb4d03 100644
--- a/charts/free5gc/charts/free5gc-chf/templates/chf-deployment.yaml
+++ b/charts/free5gc/charts/free5gc-chf/templates/chf-deployment.yaml
@@ -60,6 +60,20 @@ spec:
         - name: metrics
           containerPort: {{ $.Values.chf.configuration.metrics.port }}
         {{- end }}
+        {{- if dig "mongodbAuth" "enabled" false $.Values.global }}
+        # free5gc-gcp-terraform patch 0003: render a copy of the NF config with
+        # the authenticated MongoDB URI into a memory-backed volume. awk reads
+        # the URI from the environment, so it never appears in argv.
+        command:
+          - "/sbin/tini"
+          - "--"
+          - "/bin/sh"
+          - "-c"
+          - >-
+            awk '{ gsub(/mongodb:\/\/[^ ]+/, ENVIRON["MONGODB_URI"]); print }'
+            ./config/chfcfg.yaml > /free5gc/runtime/chfcfg.yaml
+            && exec ./chf -c /free5gc/runtime/chfcfg.yaml
+        {{- else }}
         command:
           - "/sbin/tini"
           - "--"
@@ -67,7 +81,19 @@ spec:
         args:
           - "-c"
           - "./config/chfcfg.yaml"
+        {{- end }}
         env:
+        {{- if dig "mongodbAuth" "enabled" false $.Values.global }}
+        {{- with $.Values.global.mongodbAuth }}
+          - name: MONGODB_PASSWORD
+            valueFrom:
+              secretKeyRef:
+                name: {{ .secretName }}
+                key: {{ .passwordKey }}
+          - name: MONGODB_URI
+            value: "mongodb://{{ .username }}:$(MONGODB_PASSWORD)@{{ $.Values.mongodb.service.name }}:{{ $.Values.mongodb.service.port }}/{{ .database }}?authSource={{ .database }}"
+        {{- end }}
+        {{- end }}
           - name: GIN_MODE
             value: release
         {{- if .readinessProbe.enabled }}
@@ -103,6 +129,10 @@ spec:
           failureThreshold: {{ .livenessProbe.failureThreshold | default 3 }}
         {{- end }}
         volumeMounts:
+        {{- if dig "mongodbAuth" "enabled" false $.Values.global }}
+          - mountPath: /free5gc/runtime
+            name: mongodb-auth-runtime
+        {{- end }}
           - mountPath: {{ .volume.mount }}
             name: {{ include "free5gc-chf.fullname" $ }}-volume
           - mountPath: {{ .volume.tlsmount }}
@@ -121,6 +151,12 @@ spec:
         {{- toYaml .tolerations | nindent 8 }}
 
       volumes:
+      {{- if dig "mongodbAuth" "enabled" false $.Values.global }}
+        - name: mongodb-auth-runtime
+          emptyDir:
+            medium: Memory
+            sizeLimit: 1Mi
+      {{- end }}
         - name: {{ include "free5gc-chf.fullname" $ }}-volume
           projected:
             sources:
